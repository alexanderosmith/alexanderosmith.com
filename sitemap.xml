---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for post in site.posts %}
  <url><loc>{{ post.url | absolute_url }}</loc><lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod></url>
{%- endfor %}
{%- for p in site.html_pages %}{% unless p.sitemap == false or p.url == '/404.html' %}
  <url><loc>{{ p.url | replace: 'index.html', '' | absolute_url }}</loc></url>
{%- endunless %}{% endfor %}
{%- for f in site.static_files %}{% if f.extname == '.pdf' %}
  <url><loc>{{ f.path | absolute_url }}</loc></url>
{%- endif %}{% endfor %}
</urlset>
