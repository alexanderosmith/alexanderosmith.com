---
layout: null
---
{%- comment %} root-relative href/src → absolute: JSON Feed requires it, RSS has no xml:base {% endcomment -%}
{%- assign abs_href = 'href="' | append: site.url | append: '/' -%}
{%- assign abs_src = 'src="' | append: site.url | append: '/' -%}
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.data.seo.blog_title | jsonify }},
  "description": {{ site.description | jsonify }},
  "home_page_url": {{ '/' | absolute_url | jsonify }},
  "feed_url": {{ page.url | absolute_url | jsonify }},
  "language": {{ site.data.seo.locale | replace: '_', '-' | downcase | jsonify }},
  "authors": [{ "name": {{ site.author-name | jsonify }}, "url": {{ '/' | absolute_url | jsonify }} }],
  "items": [
    {%- for post in site.posts limit: 10 %}
    {
      "id": {{ post.id | absolute_url | jsonify }},
      "url": {{ post.url | absolute_url | jsonify }},
      "title": {{ post.title | strip_html | jsonify }},
      "summary": {{ post.excerpt | strip_html | normalize_whitespace | strip | jsonify }},
      "content_html": {{ post.content | replace: 'href="/', abs_href | replace: 'src="/', abs_src | jsonify }},
      {%- if post.image %}
      "image": {{ '/images/' | append: post.image | absolute_url | jsonify }},
      {%- endif %}
      "date_published": {{ post.date | date_to_xmlschema | jsonify }},
      "tags": {{ post.tags | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
