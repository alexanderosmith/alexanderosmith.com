source "https://rubygems.org"

# any Ruby 3.3.x; .ruby-version (3.3.6) picks the default for rbenv and Netlify
ruby "~> 3.3.0"

# ~> 4.4.1 takes 4.4.x patch releases (bundle update jekyll), never 4.5
gem "jekyll", "~> 4.4.1"

# Windows only: Jekyll needs tzinfo to apply `timezone:` from _config.yml
gem "tzinfo-data", platforms: [:windows]
